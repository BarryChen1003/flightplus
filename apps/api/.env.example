# FlightPlus API — Environment Variables
# Copy this file to .env and fill in the values

# === Required — GET YOUR TOKEN AT https://www.travelpayouts.com/programs/100/tools/api ===
TRAVELPAYOUTS_TOKEN=

# === Optional ===
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated origins
# Development: http://localhost:3000
# Vercel preview: https://flightplus-git-*.vercel.app
# Vercel production: https://flightplus.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# TP marker (from Travelpayouts dashboard)
TP_MARKER=320764

# === Upstash Redis（Phase 2）===
# Get these from https://console.upstash.com → your database → REST API
# Upstash Free Tier: 256MB / 500K commands/month — 完全免費，不需要信用卡
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=