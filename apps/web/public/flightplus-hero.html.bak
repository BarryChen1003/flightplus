<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FlightPlus — 鯊魚游啊游</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { overflow: hidden; background: #0a1628; }
    canvas { display: block; }
  </style>
</head>
<body>
<script>
p5.disableFriendlyErrors = true;

// ── 四季調色盤 ──────────────────────────────────────────────────
const SEASONS = {
  skyTop:    ['#0d1b4b', '#1565a0', '#2196f3', '#5ba3c8'],
  skyBottom: ['#c8dff0', '#ffe0a0', '#fff9e6', '#ffd6a0'],
  sunColor:  ['#aaccff', '#fff0a0', '#fffae0', '#ffb347'],
  oceanTop:  ['#073b6b', '#0e6ba8', '#1a8fc4', '#0e6b8a'],
  oceanBot:  ['#0a2a4a', '#1a5a7a', '#2a8aaa', '#1a4a6a'],
};

// MOTION_INTENSITY: 5（60fps 連續動畫，高於 Pre-Flight 門檻
// → 必須實作 prefers-reduced-motion 降級方案）

// ── prefers-reduced-motion ───────────────────────────────────────
const REQUIRES_REDUCED_MOTION =
  typeof window !== 'undefined' &&
  window.matchMedia &&
  window.matchMedia('(prefers-reduced-motion: reduce)').matches;

// 某個固定 seed，視覺固定
const SEED = 7201;
let t = 0;           // global time
let seasonIdx = 0;    // 0=冬 1=春 2=夏 3=秋
let clouds = [];
let bubble = [];
let fish_school = [];
let shark;
let airplane;

// ── 效能優化：快取顏色（避免每幀重建 p5.Color 對象）──────────────
let cachedSunColor;       // p5.Color：太陽本體
let cachedSunGlow;        // p5.Color：光芒（含 alpha）
let cachedWaveColors;     // Array：3條波浪的 RGBA 顏色

function cacheColorsForSeason(idx) {
  const sc = SEASONS.sunColor[idx];
  cachedSunColor = color(sc);
  // '88' = 50% alpha hex
  cachedSunGlow = color(red(cachedSunColor), green(cachedSunColor), blue(cachedSunColor), 136);

  // 預計算 3 條波浪的 RGBA 顏色（避免 drawWaves 每幀重建）
  cachedWaveColors = [];
  for (let w = 0; w < 3; w++) {
    let alpha = 60 - w * 15;
    cachedWaveColors.push(color(100, 160, 220, alpha));
  }
}

// ──────────────────────────────────────────────────────────────
function setup() {
  createCanvas(windowWidth, windowHeight);
  colorMode(RGB, 255, 255, 255, 255);
  randomSeed(SEED);
  noiseSeed(SEED);

  // 生態系統
  shark = new Shark(width * 0.55, height * 0.62);
  for (let i = 0; i < 28; i++) fish_school.push(new Fish());
  for (let i = 0; i < 6; i++) clouds.push(new Cloud(i * (width / 5) + random(200)));
  airplane = new Airplane();

  // 預快取初始季色彩
  cacheColorsForSeason(0);

  frameRate(60);

  // ── prefers-reduced-motion：系統要求減少動畫時靜止 ─────────
  if (REQUIRES_REDUCED_MOTION) {
    noLoop();
    return;
  }

  // ── Tab visibility pause（背景時停止，節省 CPU + 避免 deltaTime 累積） ──
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') {
      noLoop();
    } else {
      loop();
    }
  });
}

// ──────────────────────────────────────────────────────────────
function draw() {
  t += deltaTime * 0.001;

  // 四季自動循環（大約每 8 秒換一季）
  const newSeasonIdx = Math.floor((t / 8) % 4);
  if (newSeasonIdx !== seasonIdx) {
    seasonIdx = newSeasonIdx;
    cacheColorsForSeason(seasonIdx); // 換季時重建顏色快取
  }

  // ── 1. 天空（漸層 + 四季）──────────────────────────────────
  drawSky();

  // ── 2. 太陽 + 光暈 ───────────────────────────────────────
  drawSun();

  // ── 3. 雲朵 ───────────────────────────────────────────────
  for (let c of clouds) { c.update(); c.display(); }

  // ── 4. 飛機 + 尾跡 ────────────────────────────────────────
  airplane.update();
  airplane.display();

  // ── 5. 海水（漸層）────────────────────────────────────────
  drawOcean();

  // ── 6. 遠景小魚群（裝飾性）───────────────────────────────
  for (let f of fish_school) { f.update(); f.display(); }

  // ── 7. 鯊魚 ───────────────────────────────────────────────
  shark.update(t);
  shark.display();

  // ── 8. 氣泡（標記+過濾模式，效能優化）───────────────────────────────
  for (let b of bubble) { b.update(); b.display(); }
  // 一次過濾移除已漂至水面的氣泡（O(n)，避免 splice 每幀移動陣列）
  bubble = bubble.filter(b => b.y >= height * 0.43);
  if (shark.blowBubble && frameCount % 6 === 0) {
    bubble.push(new Bubble(shark.x - 30, shark.y + 8));
  }
}

// ══════════════════════════════════════════════════════════════
//  繪圖輔助
// ══════════════════════════════════════════════════════════════

function drawSky() {
  const s = SEASONS;
  // 垂直線性漸層：上方固定深度，往下過渡
  for (let y = 0; y < height * 0.56; y++) {
    let inter = y / (height * 0.56);
    let c;
    if (inter < 0.5) {
      c = lerpColor(color(s.skyTop[seasonIdx]), color(s.skyBottom[seasonIdx]), inter * 2);
    } else {
      c = lerpColor(color(s.skyBottom[seasonIdx]), color(s.skyBottom[(seasonIdx + 1) % 4]), (inter - 0.5) * 2);
      // 簡化：就用底層色
      c = color(s.skyBottom[seasonIdx]);
    }
    stroke(c);
    line(0, y, width, y);
  }
  // 底部加一條柔和過渡
  noStroke();
  for (let y = Math.floor(height * 0.43); y < Math.floor(height * 0.56); y++) {
    let inter = (y - height * 0.43) / (height * 0.13);
    let c = lerpColor(color(s.skyBottom[seasonIdx]), color(s.oceanTop[seasonIdx]), inter);
    fill(c);
    rect(0, y, width, 1);
  }
}

function drawSun() {
  const sx = width * 0.78;
  const sy = height * 0.11 + seasonIdx * 18; // 春夏秋冬太陽微調高度

  // 光暈（使用快取，減少每幀 GC）
  noStroke();
  for (let r = 120; r > 0; r -= 12) {
    let a = map(r, 120, 0, 5, 50);
    fill(red(cachedSunColor), green(cachedSunColor), blue(cachedSunColor), a);
    ellipse(sx, sy, r * 2, r * 2);
  }
  // 核心（使用快取）
  fill(cachedSunColor);
  ellipse(sx, sy, 70, 70);
  // 光芒（使用含 alpha 的快取顏色）
  push();
  translate(sx, sy);
  rotate(t * 0.12);
  stroke(cachedSunGlow);
  strokeWeight(1.5);
  for (let i = 0; i < 8; i++) {
    rotate(TWO_PI / 8);
    line(38, 0, 62, 0);
  }
  pop();
}

function drawOcean() {
  const s = SEASONS;
  noStroke();
  for (let y = Math.floor(height * 0.56); y < height; y++) {
    let inter = (y - height * 0.56) / (height * 0.44);
    let c = lerpColor(color(s.oceanTop[seasonIdx]), color(s.oceanBot[seasonIdx]), inter);
    fill(c);
    rect(0, y, width, 1);
  }
  // 海面波浪線
  drawWaves();
}

function drawWaves() {
  const wy = height * 0.56;
  noFill();
  strokeWeight(2.5);

  for (let w = 0; w < 3; w++) {
    let waveY = wy + w * 5;
    stroke(cachedWaveColors[w]); // 使用預快取顏色（避免每幀重建）
    beginShape();
    for (let x = 0; x <= width; x += 3) {
      let y = waveY
        + Math.sin(x * 0.012 + t * 1.1 + w * 1.2) * 4
        + Math.sin(x * 0.025 + t * 0.7) * 2.5;
      vertex(x, y);
    }
    endShape();
  }
}

// ══════════════════════════════════════════════════════════════
//  鯊魚
// ══════════════════════════════════════════════════════════════
class Shark {
  constructor(x, y) {
    this.x = x;
    this.baseY = y;
    this.y = y;
    this.vx = 0.9;
    this.dir = -1;            // 向左游
    this.tailAngle = 0;
    this.blowBubble = true;
  }

  update(time) {
    this.x += this.vx * this.dir;
    if (this.x < -120) this.x = width + 120;
    // 上下輕擺
    this.y = this.baseY + Math.sin(time * 1.8 + 0.5) * 22;
    // 尾巴擺動
    this.tailAngle = Math.sin(time * 4) * 0.45;
    // 氣泡頻率
    this.blowBubble = Math.sin(time * 2.3) > 0.3;
  }

  display() {
    push();
    translate(this.x, this.y);
    scale(this.dir, 1);

    let bodyWave = Math.sin(t * 3.5) * 0.08;

    // ── 陰影/反射在水底 ──
    noStroke();
    fill(0, 30, 70, 40);
    ellipse(5, 90, 100, 18);

    // ── 尾鰭 ──
    this._tail(bodyWave);

    // ── 身體 ──
    this._body(bodyWave);

    // ── 背鰭 ──
    this._dorsalFin(bodyWave);

    // ── 胸鰭 ──
    this._pectFin(bodyWave);

    // ── 眼睛 + 表情 ──
    this._face();

    // ── 花紋線條 ──
    this._stripes(bodyWave);

    pop();
  }

  _tail(wave) {
    push();
    translate(-52, 2);
    rotate(this.tailAngle + wave);
    fill(72, 95, 115);
    noStroke();
    beginShape();
    vertex(0, 0);
    bezierVertex(-18, -28, -52, -32, -62, -10);
    bezierVertex(-50, 4, -18, 12, 0, 0);
    endShape(CLOSE);
    pop();
  }

  _body(wave) {
    // 胖胖的 Q 版身體（貝茲曲線）
    fill(82, 108, 132);
    noStroke();
    beginShape();
    vertex(55, 0);
    bezierVertex(62, -30, 28, -46, -5, -42 + wave * 80);
    bezierVertex(-32, -36, -52, -14, -52, 0 + wave * 30);
    bezierVertex(-52, 14, -32, 36, -5, 42 + wave * 80);
    bezierVertex(28, 46, 62, 30, 55, 0);
    endShape(CLOSE);

    // 肚皮（淺色）
    fill(148, 180, 205);
    beginShape();
    vertex(50, 5);
    bezierVertex(55, 10, 30, 28, 5, 28 + wave * 50);
    bezierVertex(-18, 28, -38, 10, -42, 5 + wave * 20);
    bezierVertex(-38, -5, -18, -18, 5, -20 + wave * 50);
    bezierVertex(30, -28, 55, -10, 50, 5);
    endShape(CLOSE);
  }

  _dorsalFin(wave) {
    fill(62, 82, 105);
    noStroke();
    beginShape();
    vertex(5, -40 + wave * 80);
    bezierVertex(10, -72, 30, -82, 38, -78 + wave * 60);
    bezierVertex(30, -70, 15, -56, 5, -42 + wave * 80);
    endShape(CLOSE);
  }

  _pectFin(wave) {
    fill(72, 95, 115);
    noStroke();
    // 下胸鰭
    beginShape();
    vertex(22, 24 + wave * 60);
    bezierVertex(18, 52, -8, 62, -18, 54 + wave * 30);
    bezierVertex(-8, 48, 5, 34, 22, 26 + wave * 60);
    endShape(CLOSE);
  }

  _face() {
    // 眼睛白
    fill(240, 245, 255);
    ellipse(28, -12, 26, 26);
    // 虹膜
    fill(20, 25, 38);
    ellipse(30, -11, 16, 17);
    // 瞳孔高光
    fill(255, 255, 255);
    ellipse(33, -15, 6, 7);
    ellipse(27, -8, 3, 3);

    // 眼睛範圍線（可愛感）
    noFill();
    stroke(40, 55, 75, 100);
    strokeWeight(1);
    arc(28, -11, 24, 22, PI * 0.1, PI * 0.9);

    // 微笑嘴巴
    noFill();
    stroke(50, 68, 90);
    strokeWeight(2.2);
    arc(8, 10, 28, 18, 0.1, PI - 0.1);

    // 腮紅
    noStroke();
    fill(255, 130, 130, 55);
    ellipse(38, 4, 18, 10);
    ellipse(8, 8, 14, 8);

    // 鯊魚經典牙齒（小三角）
    fill(240, 248, 255);
    noStroke();
    let tx = [2, 8, 14, 20];
    for (let dx of tx) {
      triangle(dx - 3, 15, dx, 20, dx + 3, 15);
    }
  }

  _stripes(wave) {
    noFill();
    stroke(62, 82, 105, 120);
    strokeWeight(1.2);
    // 身體中線條紋（裝飾）
    for (let i = 0; i < 4; i++) {
      let bx = -20 + i * 20 + wave * 15;
      let by0 = -25 + wave * 80;
      let by1 = 25 + wave * 80;
      line(bx, by0, bx, by1);
    }
  }
}

// ══════════════════════════════════════════════════════════════
//  小魚群（裝飾性）
// ══════════════════════════════════════════════════════════════
class Fish {
  constructor() {
    this.reset();
  }
  reset() {
    this.x = random(width + 50);
    this.y = random(height * 0.58, height * 0.95);
    this.speed = random(0.4, 1.8);
    this.size = random(5, 14);
    this.dir = random() > 0.3 ? -1 : 1;
    this.wobble = random(TWO_PI);
    this.hue = random(170, 230);
    this.alpha = random(120, 210);
  }
  update() {
    this.x += this.speed * this.dir;
    this.wobble += 0.05;
    this.y += Math.sin(this.wobble) * 0.4;
    if ((this.dir < 0 && this.x < -30) || (this.dir > 0 && this.x > width + 30)) {
      this.reset();
      this.x = this.dir < 0 ? width + 30 : -30;
    }
  }
  display() {
    push();
    translate(this.x, this.y);
    scale(this.dir, 1);
    fill(this.hue, 80, 90, this.alpha);
    noStroke();
    beginShape();
    vertex(this.size, 0);
    bezierVertex(this.size * 0.3, -this.size * 0.8, -this.size * 0.5, -this.size * 0.7, -this.size, -this.size * 0.2);
    bezierVertex(-this.size * 1.2, 0, -this.size, this.size * 0.2, -this.size, 0);
    bezierVertex(-this.size * 0.5, this.size * 0.7, this.size * 0.3, this.size * 0.8, this.size, 0);
    endShape(CLOSE);
    // 尾鰭
    fill(this.hue, 80, 80, this.alpha * 0.8);
    triangle(-this.size, -this.size * 0.2, -this.size * 1.6, -this.size * 0.7, -this.size * 1.4, this.size * 0.4);
    pop();
  }
}

// ══════════════════════════════════════════════════════════════
//  雲朵
// ══════════════════════════════════════════════════════════════
class Cloud {
  constructor(x) {
    this.x = x ?? random(width);
    this.y = random(height * 0.04, height * 0.3);
    this.speed = random(0.12, 0.32);
    this.w = random(100, 220);
    this.h = random(40, 80);
    this.alpha = random(170, 240);
    this.puffs = [];
    let n = Math.floor(random(4, 8));
    for (let i = 0; i < n; i++) {
      this.puffs.push({
        ox: random(-this.w * 0.4, this.w * 0.4),
        oy: random(-this.h * 0.35, this.h * 0.25),
        r: random(this.h * 0.3, this.h * 0.55),
      });
    }
  }
  update() {
    this.x -= this.speed;
    if (this.x < -this.w) this.x = width + this.w;
    // 四季高度微調
    let targetY = height * (0.04 + seasonIdx * 0.06);
    this.y += (targetY - this.y) * 0.003;
  }
  display() {
    noStroke();
    for (let p of this.puffs) {
      fill(255, 255, 255, this.alpha);
      ellipse(this.x + p.ox, this.y + p.oy, p.r * 2, p.r * 1.5);
    }
  }
}

// ══════════════════════════════════════════════════════════════
//  飛機
// ══════════════════════════════════════════════════════════════
class Airplane {
  constructor() {
    this.trail = [];
    this.x = -80;
    this.y = height * 0.18;
    this.speed = 2.2;
    this.resetY();
  }
  resetY() {
    this.baseY = height * (0.12 + seasonIdx * 0.04);
    this.y = this.baseY;
  }
  update() {
    this.y += (this.baseY - this.y) * 0.02;
    this.x += this.speed;
    if (this.x > width + 100) {
      this.x = -80;
      this.trail = [];
    }
    this.trail.push({ x: this.x - 28, y: this.y });
    if (this.trail.length > 40) this.trail.shift();
  }
  display() {
    // 尾跡
    noFill();
    strokeWeight(1.5);
    for (let i = 1; i < this.trail.length; i++) {
      let a = map(i, 0, this.trail.length, 0, 60);
      stroke(200, 220, 240, a);
      line(this.trail[i - 1].x, this.trail[i - 1].y, this.trail[i].x, this.trail[i].y);
    }
    // 飛機本體（Q版可愛風）
    push();
    translate(this.x, this.y);
    fill(230, 235, 245);
    noStroke();
    // 機身
    ellipse(0, 0, 60, 14);
    // 機頭
    fill(200, 215, 235);
    ellipse(30, 0, 18, 10);
    // 機翼
    fill(220, 228, 240);
    beginShape();
    vertex(-5, 0);
    bezierVertex(-15, -22, -28, -26, -35, -22);
    bezierVertex(-28, -14, -15, -5, -5, 0);
    endShape(CLOSE);
    beginShape();
    vertex(-5, 0);
    bezierVertex(-15, 22, -28, 26, -35, 22);
    bezierVertex(-28, 14, -15, 5, -5, 0);
    endShape(CLOSE);
    // 尾翼
    fill(210, 220, 235);
    beginShape();
    vertex(-28, 0);
    bezierVertex(-35, -14, -42, -18, -46, -14);
    bezierVertex(-42, -8, -38, 0, -28, 0);
    endShape(CLOSE);
    // 窗戶
    fill(150, 200, 240, 200);
    ellipse(10, -1, 7, 6);
    ellipse(20, -1, 7, 6);
    pop();
  }
}

// ══════════════════════════════════════════════════════════════
//  氣泡
// ══════════════════════════════════════════════════════════════
class Bubble {
  constructor(x, y) {
    this.x = x;
    this.y = y;
    this.r = random(3, 7);
    this.speed = random(0.8, 1.8);
    this.wobble = random(TWO_PI);
  }
  update() {
    this.y -= this.speed;
    this.wobble += 0.08;
    this.x += Math.sin(this.wobble) * 0.5;
  }
  display() {
    noFill();
    stroke(160, 210, 255, 160);
    strokeWeight(1);
    ellipse(this.x, this.y, this.r * 2, this.r * 2);
    // 高光
    fill(255, 255, 255, 120);
    noStroke();
    ellipse(this.x - this.r * 0.3, this.y - this.r * 0.3, this.r * 0.6, this.r * 0.6);
  }
}

// ── 視窗大小響應 ────────────────────────────────────────────
function windowResized() {
  // displayWidth/displayHeight 比 windowWidth/Height 更穩定
  // （不因 iOS 地址列開關而觸發錯誤重排）
  resizeCanvas(
    typeof displayWidth !== 'undefined' ? displayWidth : windowWidth,
    typeof displayHeight !== 'undefined' ? displayHeight : windowHeight
  );
  if (shark) {
    shark.baseY = height * 0.62;
    shark.x = width * 0.55;
  }
}

// 按 S 儲存截圖
function keyPressed() {
  if (key === 's' || key === 'S') saveCanvas('flightplus-shark', 'png');
  if (key === 'g' || key === 'G') saveGif('flightplus-shark', 5);
}
</script>
</body>
</html>